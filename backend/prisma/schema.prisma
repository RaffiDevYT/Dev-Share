datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id              Int              @id @default(autoincrement())
  username        String           @unique @db.VarChar(50)
  email           String           @unique @db.VarChar(100)
  password        String           @db.VarChar(255)
  bio             String?          @db.VarChar(255)
  githubUrl       String?          @db.VarChar(150)
  websiteUrl      String?          @db.VarChar(150)
  location        String?          @db.VarChar(100)
  skills          String?          @db.VarChar(255)
  createdAt       DateTime         @default(now())
  snippets        Snippet[]
  bookmarks       Bookmark[]
  comments        Comment[]
  profileMessages ProfileMessage[] @relation("ProfileReceivedMessages")
  sentMessages    ProfileMessage[] @relation("ProfileSentMessages")
  forumTopics     ForumTopic[]
  forumReplies    ForumReply[]

  @@map("users")
}

model Snippet {
  id          Int        @id @default(autoincrement())
  title       String     @db.VarChar(150)
  description String?    @db.Text
  codeContent String     @db.LongText
  language    String     @db.VarChar(50)
  tags        String?    @db.VarChar(255)
  folder      String?    @db.VarChar(100)
  isPublic    Boolean    @default(true)
  userId      Int
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookmarks   Bookmark[]
  comments    Comment[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@map("snippets")
}

model Bookmark {
  id        Int      @id @default(autoincrement())
  userId    Int
  snippetId Int
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  snippet   Snippet  @relation(fields: [snippetId], references: [id], onDelete: Cascade)

  @@unique([userId, snippetId])
  @@map("bookmarks")
}

model Comment {
  id        Int      @id @default(autoincrement())
  content   String   @db.Text
  snippetId Int
  userId    Int
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  snippet   Snippet  @relation(fields: [snippetId], references: [id], onDelete: Cascade)

  @@map("comments")
}

model ProfileMessage {
  id            Int              @id @default(autoincrement())
  content       String           @db.Text
  profileUserId Int
  authorId      Int
  parentId      Int?
  createdAt     DateTime         @default(now())

  profileUser   User             @relation("ProfileReceivedMessages", fields: [profileUserId], references: [id], onDelete: Cascade)
  author        User             @relation("ProfileSentMessages", fields: [authorId], references: [id], onDelete: Cascade)
  parent        ProfileMessage?  @relation("MessageReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies       ProfileMessage[] @relation("MessageReplies")

  @@map("profile_messages")
}

model ForumTopic {
  id        Int          @id @default(autoincrement())
  title     String       @db.VarChar(200)
  content   String       @db.Text
  category  String       @default("Umum") @db.VarChar(50)
  userId    Int
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  replies   ForumReply[]

  @@map("forum_topics")
}

model ForumReply {
  id        Int        @id @default(autoincrement())
  content   String     @db.Text
  topicId   Int
  userId    Int
  createdAt DateTime   @default(now())
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  topic     ForumTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@map("forum_replies")
}


